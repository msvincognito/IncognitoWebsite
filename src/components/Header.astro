---
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Events', href: '/archive/events' },
  { label: 'Committees', href: '/committees' },
  { label: 'Tutors', href: '/tutors' },
  { label: 'Wiki', href: 'https://wiki.msvincognito.nl' },
  { label: 'Store', href: 'https://store.msvincognito.nl' },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="MSV Incognito home">
    <img class="brand-light" src="/assets/logo-dark.png" alt="" width="650" height="159" />
    <img class="brand-dark" src="/assets/logo.svg" alt="" width="650" height="159" />
  </a>

  <button class="menu-toggle" aria-expanded="false" aria-controls="site-menu">
    <span>Menu</span>
    <span class="menu-lines" aria-hidden="true"></span>
  </button>

  <nav id="site-menu" class="site-menu" aria-label="Primary navigation">
    {navItems.map((item) => (
      <a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch color theme">
      <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z" /></svg>
      <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <span class="theme-label">Theme</span>
    </button>
    <a class="nav-cta" href="/contact">Contact <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#site-menu');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('is-open', !open);
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const updateThemeLabel = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    themeToggle?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`);
  };

  updateThemeLabel();
  themeToggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem('incognito-theme', nextTheme);
    updateThemeLabel();
  });
</script>
