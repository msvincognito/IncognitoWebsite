---
import BaseLayout from '../layouts/BaseLayout.astro';

const ticketUrl = 'https://www.sunweb.nl/groups/totallysnow/bookingpage/extras?bookingNumber=6627072';
---

<BaseLayout
  title="Ski Trip 2026"
  description="Join MSV Incognito for Ski Trip 2026 and get your tickets."
  pageClass="ski-trip-page"
  robots="noindex, nofollow"
>
  <section class="ski-hero">
    <div class="ski-hero__grid" aria-hidden="true"></div>
    <div class="ski-hero__peak ski-hero__peak--back" aria-hidden="true"></div>
    <div class="ski-hero__peak ski-hero__peak--front" aria-hidden="true"></div>

    <div class="shell ski-hero__shell">
      <div class="ski-hero__copy">
        <p class="eyebrow"><span></span> MSV Incognito presents</p>
        <h1>Ski Trip<br /><em>2026</em></h1>
        <p class="ski-hero__intro">
          The mountains are calling. Watch what is waiting for you, then secure your place on the trip.
        </p>

        <a
          class="ski-ticket-button"
          href={ticketUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-external
        >
          <span>Get your tickets now!</span>
          <span class="ski-ticket-button__arrow" aria-hidden="true">↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>

        <div class="ski-hero__stamp" aria-hidden="true">
          <span>INC</span>
          <strong>26</strong>
        </div>
      </div>

      <div class="ski-video-block">
        <div class="ski-video-block__label" aria-hidden="true">
          <span>Watch the trailer</span>
          <strong>01</strong>
        </div>
        <div class="ski-video-frame">
          <iframe
            src="https://www.youtube.com/embed/fl76DrUPt0w?feature=oembed"
            title="Ski Trip 2026 video"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="ski-callout" aria-labelledby="ski-callout-title">
    <div class="shell ski-callout__inner">
      <p class="ski-callout__number" aria-hidden="true">02</p>
      <div>
        <p class="eyebrow">Ready for the mountain?</p>
        <h2 id="ski-callout-title">Your spot is one click away.</h2>
      </div>
      <a
        class="button button-dark"
        href={ticketUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-external
      >
        Get your tickets now! <span aria-hidden="true">↗</span>
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .ski-hero {
    position: relative;
    overflow: hidden;
    min-height: 760px;
    background: var(--footer);
    color: var(--on-dark);
    isolation: isolate;
  }

  .ski-hero::before {
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    width: min(45vw, 680px);
    height: 7px;
    background: var(--pink);
    content: '';
  }

  .ski-hero__grid {
    position: absolute;
    z-index: -3;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, .055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .055) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(90deg, #000 0%, rgba(0, 0, 0, .8) 60%, transparent 100%);
  }

  .ski-hero__peak {
    position: absolute;
    z-index: -2;
    bottom: -1px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .ski-hero__peak--back {
    right: 17%;
    width: min(44vw, 660px);
    height: min(34vw, 510px);
    background: #102b4b;
  }

  .ski-hero__peak--front {
    right: -10%;
    width: min(52vw, 790px);
    height: min(25vw, 390px);
    background: var(--blue);
    opacity: .92;
  }

  .ski-hero__shell {
    display: grid;
    min-height: 760px;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 420px);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .ski-hero__copy {
    position: relative;
    padding-block: 2rem;
  }

  .ski-hero .eyebrow {
    margin-bottom: 1.6rem;
    color: #9ec4ff;
  }

  .ski-hero h1 {
    max-width: 720px;
    font-size: clamp(5rem, 11vw, 10rem);
    letter-spacing: -.06em;
    line-height: .78;
    text-transform: uppercase;
  }

  .ski-hero h1 em {
    color: var(--pink);
    font-style: normal;
  }

  .ski-hero__intro {
    max-width: 560px;
    margin-top: 2.3rem;
    color: #cbd8e8;
    font-size: clamp(1.05rem, 1.8vw, 1.26rem);
  }

  .ski-ticket-button {
    display: inline-flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 2.25rem;
    margin-top: 2.25rem;
    padding: 0 1.5rem;
    background: var(--pink);
    color: #fff;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .08em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    transition: background .2s ease, transform .2s ease;
  }

  .ski-ticket-button:hover {
    background: #ff50a2;
    transform: translateY(-3px);
  }

  .ski-ticket-button__arrow {
    font-size: 1.25rem;
    transition: transform .2s ease;
  }

  .ski-ticket-button:hover .ski-ticket-button__arrow { transform: translate(3px, -3px); }

  .ski-hero__stamp {
    position: absolute;
    right: 1rem;
    bottom: -.5rem;
    display: grid;
    width: 92px;
    height: 92px;
    align-content: center;
    border: 1px solid rgba(255, 255, 255, .34);
    text-align: center;
    transform: rotate(-7deg);
  }

  .ski-hero__stamp span {
    color: #9ec4ff;
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .22em;
  }

  .ski-hero__stamp strong {
    font-family: var(--display);
    font-size: 2.65rem;
    line-height: .9;
  }

  .ski-video-block {
    position: relative;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: end;
  }

  .ski-video-block__label {
    display: flex;
    height: 100%;
    min-height: 420px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding-block: .2rem .6rem;
    color: #9ec4ff;
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .ski-video-block__label span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .ski-video-block__label strong { color: var(--pink); }

  .ski-video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border: 1px solid rgba(255, 255, 255, .36);
    background: #020813;
    box-shadow: 24px 24px 0 rgba(21, 94, 239, .55);
  }

  .ski-video-frame::before,
  .ski-video-frame::after {
    position: absolute;
    z-index: 1;
    width: 42px;
    height: 5px;
    background: var(--pink);
    content: '';
    pointer-events: none;
  }

  .ski-video-frame::before { top: -3px; left: -1px; }
  .ski-video-frame::after { right: -1px; bottom: -3px; }

  .ski-video-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ski-callout {
    border-bottom: 1px solid var(--line);
    background: var(--blue);
    color: #fff;
  }

  .ski-callout__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .ski-callout__number {
    align-self: start;
    color: #9ec4ff;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .16em;
  }

  .ski-callout .eyebrow { margin-bottom: .8rem; color: #d9e8ff; }

  .ski-callout h2 {
    max-width: 720px;
    font-size: clamp(2.6rem, 5vw, 5rem);
  }

  .ski-callout .button-dark {
    min-height: 62px;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .ski-hero__shell {
      grid-template-columns: minmax(0, 1fr) minmax(250px, 330px);
      gap: 2.5rem;
    }

    .ski-hero__stamp { display: none; }
    .ski-callout__inner { grid-template-columns: auto 1fr; }
    .ski-callout .button { grid-column: 2; justify-self: start; }
  }

  @media (max-width: 680px) {
    .ski-hero__peak--back { right: -25%; width: 110vw; height: 75vw; }
    .ski-hero__peak--front { right: -45%; width: 125vw; height: 60vw; opacity: .6; }

    .ski-hero__shell {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      padding-block: 4rem 5.5rem;
    }

    .ski-hero h1 { font-size: clamp(4.6rem, 25vw, 7rem); }
    .ski-hero__copy { padding-block: 0; }
    .ski-ticket-button { width: 100%; }

    .ski-video-block {
      width: min(100%, 380px);
      grid-template-columns: 32px minmax(0, 1fr);
      margin-inline: auto;
    }

    .ski-video-frame { box-shadow: 14px 14px 0 rgba(21, 94, 239, .65); }

    .ski-callout__inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .ski-callout__number { display: none; }
    .ski-callout .button { grid-column: 1; width: 100%; margin-top: .75rem; white-space: normal; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ski-ticket-button,
    .ski-ticket-button__arrow { transition: none; }
  }
</style>
