# Long-cache fingerprinted static assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Long-cache public assets (images, logos, SVGs)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind search index
/pagefind/*
  Cache-Control: public, max-age=86400

# HTML files should revalidate frequently
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Keep the public tutor directory out of compliant search indexes
/tutors*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Keep the unlinked board report out of compliant search indexes
/33rd-board-accomplishments*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Sitemaps
/sitemap-index.xml
  Cache-Control: public, max-age=3600
